# ==============================================================================
# VeriWeave Environment Configuration
# Tagline: Retrieve intelligently. Reason contextually. Respond reliably.
# ==============================================================================

# Application
APP_NAME=VeriWeave
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Storage Paths
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
QDRANT_STORAGE_PATH=./data/qdrant_storage
QDRANT_COLLECTION_NAME=veriweave_documents

# Embeddings Configuration
# Lightweight default for Apple Silicon / 8GB RAM: all-MiniLM-L6-v2 (384 dimensions, fast inference)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Ollama LLM Configuration
# Recommended lightweight model: llama3.2:1b, llama3.2:3b, or qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_TEMPERATURE=0.1

# Fallback Generator (Active if Ollama is unreachable, returns structured grounded response)
ENABLE_FALLBACK_GENERATOR=true

# Logging
LOG_LEVEL=INFO

# Phase 3: Intelligent Query Routing & Multi-Source Configuration
DEFAULT_ROUTING_MODE=auto
ROUTING_CONFIDENCE_THRESHOLD=0.65
ENABLE_SQL_ROUTING=true
SQL_MAX_ROWS=50
SQL_EXECUTION_TIMEOUT_SECONDS=5.0
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_MAX_RESULTS=3

# Phase 4: Adaptive & Corrective RAG with LangGraph
ENABLE_ADAPTIVE_RAG=false
MAX_QUERY_REWRITES=2
MAX_ANSWER_CORRECTIONS=2
RELEVANCE_GRADE_THRESHOLD=0.5
MIN_RELEVANT_EVIDENCE_COUNT=1
ENABLE_HALLUCINATION_CHECK=true
