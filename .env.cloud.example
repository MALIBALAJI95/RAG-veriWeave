# ==============================================================================
# VeriWeave Cloud Deployment Environment Configuration (.env)
# "Retrieve intelligently. Reason contextually. Respond reliably."
# ==============================================================================

# Application Settings
APP_NAME=VeriWeave
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional API Security Protection (uncomment to require X-API-Key header)
# VERIWEAVE_API_KEY=your-secure-random-token-here

# ==============================================================================
# 1. Supabase PostgreSQL & pgvector Configuration (Free Tier: 500MB DB)
# ==============================================================================
# In Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Example: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_DB_URL=
VECTOR_STORAGE_BACKEND=pgvector
DOCUMENT_STORAGE_BACKEND=database
SUPABASE_STORAGE_BUCKET=veriweave-documents

# ==============================================================================
# 2. Cloudflare Workers AI Configuration (Free Tier: 10,000 neurons/day)
# ==============================================================================
# In Cloudflare Dashboard -> Workers & AI -> Overview -> Account ID & API Tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hosted LLM model
LLM_PROVIDER=cloudflare
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.2-1b-instruct

# Hosted Embedding model (384-dimensional)
EMBEDDING_PROVIDER=local
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5

# Graceful offline fallback (ensures response even if API limit reached)
ENABLE_FALLBACK_GENERATOR=true

# ==============================================================================
# 3. Retrieval & Routing Defaults
# ==============================================================================
DEFAULT_ROUTING_MODE=auto
DEFAULT_RETRIEVAL_STRATEGY=hybrid
ENABLE_ADAPTIVE_RAG=true
ENABLE_SQL_ROUTING=true
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER=mock
